# Ambiente de Desenvolvimento (Local)
#
# Use este arquivo para configurar variáveis no ambiente de desenvolvimento.
# Valores sensíveis NÃO devem ser usados aqui; utilize chaves e URLs locais.

# Obrigatórias
# URL de conexão do banco local (Postgres/Supabase)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# Base URL da API local (ex.: servidor dev)
API_BASE_URL=http://127.0.0.1:5173/api
# Ativa recursos de depuração detalhada
DEBUG_MODE=true

# Opcionais (com valores padrão)
# Nível de log (debug|info|warn|error)
LOG_LEVEL=debug
# Habilita ferramentas de desenvolvimento (painéis, mocks)
ENABLE_DEV_TOOLS=true
# TTL de cache em segundos
CACHE_TTL=300
# Timeout de requisições em milissegundos
REQUEST_TIMEOUT_MS=30000
# Flags de funcionalidades (lista separada por vírgulas)
FEATURE_FLAGS=
# Chave pública para clientes (apenas valores não sensíveis)
PUBLIC_CLIENT_ID=local-client

# Integrações (exemplos, substitua conforme necessário)
# URL do Supabase local (fornecido por `supabase start`)
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Chave anon do Supabase local (não use service_role no front-end)
VITE_SUPABASE_ANON_KEY=anon-local-placeholder

