# Ambiente de Produção
#
# Este arquivo é APENAS um modelo. Em produção, configure estas variáveis
# via secret manager da plataforma (GitHub Actions Secrets, Vercel, etc.).

# Obrigatórias
# URL de conexão do banco gerenciado (placeholder)
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<dbname>
# Base URL da API pública de produção
API_BASE_URL=https://api.<seu-dominio>.com
# Depuração desativada em produção
DEBUG_MODE=false

# Segurança (placeholders — substitua em secrets da plataforma)
JWT_SECRET=<definir-em-secrets>
ENCRYPTION_KEY=<definir-em-secrets>

# Otimização de performance
NODE_ENV=production
LOG_LEVEL=info
# TTL de cache em segundos (ex.: 1 dia)
CACHE_TTL=86400
# Timeout de requisições mais agressivo
REQUEST_TIMEOUT_MS=10000
# Limite de taxa (exemplo ilustrativo)
API_RATE_LIMIT_RPS=100

# Integrações (exemplos, usar secrets)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<definir-em-secrets>

